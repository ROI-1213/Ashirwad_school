<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. If files inside /dist/ exist, serve them directly when requested from root
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
  RewriteRule ^(.*)$ dist/$1 [L]

  # 2. If visiting root / and dist/index.html exists, serve dist/index.html
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^$ dist/index.html [L]

  # 3. If file or directory exists at root, serve it
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. SPA routing: route to dist/index.html if present, else index.html
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule . dist/index.html [L]

  RewriteRule . index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Prevent caching of PDFs and HTML so updates appear immediately
  <FilesMatch "\.(pdf|html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

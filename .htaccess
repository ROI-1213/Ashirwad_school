# Ensure LiteSpeed and Apache serve dist/index.html first
DirectoryIndex dist/index.html index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Block direct browser access to source code and config files
  RewriteRule ^src/ - [F,L]
  RewriteRule ^vite\.config\. - [F,L]
  RewriteRule ^package\.json - [F,L]
  RewriteRule ^tsconfig\. - [F,L]

  # 2. If visiting root /, serve dist/index.html
  RewriteRule ^$ dist/index.html [L]

  # 3. If file exists in dist, serve directly
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
  RewriteRule ^(.*)$ dist/$1 [L]

  # 4. If actual file or directory exists on disk, serve it
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. SPA routing: route all non-file URLs to dist/index.html
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule . dist/index.html [L]

  RewriteRule . index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Prevent caching of PDFs and HTML so updates appear immediately
  <FilesMatch "\.(pdf|html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>
